{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build && npm run web:build",
  "outputDirectory": "web/out",
  "functions": {
    "api/skills/index.ts": {
      "includeFiles": "dist/**"
    },
    "api/skills/search.ts": {
      "includeFiles": "dist/**"
    },
    "api/market/shelves.ts": {
      "includeFiles": "dist/**"
    },
    "api/market/search.ts": {
      "includeFiles": "dist/**"
    },
    "api/market/preview.ts": {
      "includeFiles": "dist/**"
    },
    "api/market/suggested.ts": {
      "includeFiles": "{dist/**,data/market-picks.yaml}"
    },
    "api/cron/sync-market.ts": {
      "includeFiles": "dist/**",
      "maxDuration": 300
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" }
      ]
    }
  ]
}
