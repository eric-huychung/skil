{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build && npm run web:build",
  "outputDirectory": "web/out",
  "functions": {
    "api/skills/index.ts": {
      "includeFiles": "dist/**"
    },
    "api/skills/search.ts": {
      "includeFiles": "dist/**"
    },
    "api/market/shelves.ts": {
      "includeFiles": "dist/**"
    },
    "api/market/search.ts": {
      "includeFiles": "dist/**"
    },
    "api/market/preview.ts": {
      "includeFiles": "dist/**"
    },
    "api/cron/sync-market.ts": {
      "includeFiles": "dist/**",
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/cron/sync-market",
      "schedule": "0 0 * * 0"
    }
  ]
}
