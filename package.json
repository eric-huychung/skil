{
  "name": "skil",
  "version": "0.4.0",
  "description": "CLI-first AI skill collection manager for Cursor, Claude, and Windsurf",
  "type": "module",
  "bin": {
    "skil": "dist/cli/index.js",
    "contextkit": "dist/cli/index.js"
  },
  "workspaces": [
    "gui",
    "web"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.scripts.json --noEmit",
    "sync-market": "tsx scripts/sync-market.ts",
    "gui:dev": "npm run dev --workspace=gui",
    "gui:build": "npm run build --workspace=gui",
    "gui:test": "npm run test --workspace=gui",
    "web:dev": "npm run dev --workspace=web",
    "web:build": "npm run build --workspace=web"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "@vercel/oidc": "^3.8.5",
    "axios": "^1.7.9",
    "chalk": "^5.3.0",
    "cli-table3": "^0.6.5",
    "commander": "^12.1.0",
    "execa": "^9.5.2",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.17.9",
    "jsdom": "^26.1.0",
    "nock": "^13.5.6",
    "tsx": "^4.23.12",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
