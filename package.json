{
  "name": "contextkit",
  "version": "0.1.0",
  "description": "CLI-first AI skill collection manager for Cursor, Claude, and Windsurf",
  "type": "module",
  "bin": {
    "contextkit": "dist/cli/index.js"
  },
  "workspaces": [
    "gui"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "gui:dev": "npm run dev --workspace=gui",
    "gui:build": "npm run build --workspace=gui",
    "gui:test": "npm run test --workspace=gui"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "dependencies": {
    "axios": "^1.7.9",
    "chalk": "^5.3.0",
    "cli-table3": "^0.6.5",
    "commander": "^12.1.0",
    "execa": "^9.5.2",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.17.9",
    "memfs": "^4.14.0",
    "nock": "^13.5.6",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
