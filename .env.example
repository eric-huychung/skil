# Copy to .env (gitignored). Never commit real values.
# Landing + GUI do not read this file. Sync script and Cron do.

# --- Supabase (sync + server API) ---
# URL is public. Do not prefix SERVICE_ROLE with NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- First fill / local sync ---
# skills.sh auth is Vercel OIDC, not a skills.sh API key.
#   npm i -g vercel && vercel link && vercel env pull
# That writes VERCEL_OIDC_TOKEN into .env.local — keep that file gitignored.

# --- Market shelf classify (laptop sync + same key in Vercel) ---
# Vercel AI Gateway → openai/gpt-4o-mini. ~$0.03 per weekly run.
AI_GATEWAY_API_KEY=

# --- Vercel Cron (also set in Vercel dashboard → Env) ---
CRON_SECRET=

# --- Do not set ---
# NEXT_PUBLIC_SUPABASE_SERVICE_ROLE_KEY
# SKILLS_API_KEY (we use OIDC)
# service role in the Electron app or the Next client bundle
