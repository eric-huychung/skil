{
  "name": "contextkit-gui",
  "version": "0.2.2",
  "description": "Desktop GUI for ContextKit, sharing CollectionEngine with the CLI",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.json",
