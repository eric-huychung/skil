{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["vite/client"]
  },
    "include": [
      "src/renderer/src/**/*",
      "src/shared/**/*",
      "../shared/status/**/*",
      "../src/core/status-copy.ts",
      "../src/core/dock-layout.ts",
      "../src/types/index.ts"
    ]
}
